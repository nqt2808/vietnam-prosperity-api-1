  // OpenStreetMap Nominatim Geocoder & Haversine Distance Checker
  const checkOSMDistance = async (userAddress: string): Promise<number | null> => {
    if (!userAddress.trim()) return null
    setIsGeocoding(true)
    setDistanceError('')
    
    try {
      // Append Huế, Việt Nam to make the search local and highly accurate
      const query = `${userAddress}, Thừa Thi�n Huế, Việt Nam`
      const response = await fetch(`https://nominatim.openstreetmap.org/search?format=json&limit=1&q=${encodeURIComponent(query)}`, {
        headers: {
          'Accept-Language': 'vi'
        }
      })
      const data = await response.json()
      
      if (data && data.length > 0) {
        const lat = parseFloat(data[0].lat)
        const lon = parseFloat(data[0].lon)
        
        // Shop coordinates: 16.4512061, 107.6117266 (Trung Nguy�n Legend �u Lạc Huế)
        const shopLat = 16.4512061
        const shopLon = 107.6117266
        
        // Calculate Haversine distance
        const R = 6371 // km
        const dLat = (lat - shopLat) * Math.PI / 180
        const dLon = (lon - shopLon) * Math.PI / 180
        const a = 
          Math.sin(dLat/2) * Math.sin(dLat/2) +
          Math.cos(shopLat * Math.PI / 180) * Math.cos(lat * Math.PI / 180) * 
          Math.sin(dLon/2) * Math.sin(dLon/2)
        const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a))
        const computedDistance = parseFloat((R * c).toFixed(1)) // 1 decimal place
        
        setDistance(computedDistance)
        
        if (computedDistance > 10) {
          setDistanceError(`Vui lòng kiểm tra lại địa chỉ đã nhập. Khoảng cách quá xa (${computedDistance}km > 10km) nên cửa hàng không thể nhận đơn của bạn. Cảm ơn vì đã quan tâm đến Trung Nguyên Legend Âu Lạc. Bạn có thể đặt nước ở chi nhánh gần nhất ạ. Cảm ơn khách yêu ạ.`)
          setShippingFee(0)
        } else {
          setDistanceError('')
          // Calculate shipping fee: free <= 2km, else 5,000đ/km
          if (computedDistance <= 2) {
            setShippingFee(0)
          } else {
            setShippingFee(Math.round(computedDistance * 5000))
          }
        }
        return computedDistance
      } else {
        setDistanceError('Không tìm thấy địa chỉ của bạn tại Thừa Thiên Huế. Vui lòng nhập địa chỉ cụ thể hơn (v� dụ: 12 Bến Ngh�, Huế) để kiểm tra khoảng c�ch giao h�ng.')
        setDistance('')
        setShippingFee(0)
        return null
      }
    } catch (err) {
      console.error("OSM Geocoding Error:", err)
      setDistanceError('Có lỗi xảy ra khi kiểm tra địa chỉ. Vui lòng thử lại sau.')
      return null
    } finally {
      setIsGeocoding(false)
    }
  }

